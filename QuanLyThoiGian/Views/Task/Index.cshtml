@model List<QuanLyThoiGian.Models.Entities.TaskItem>
@using QuanLyThoiGian.Models.Enums
@{
    ViewData["Title"] = "Quản lý Công việc";
    var categories = ViewBag.Categories as List<QuanLyThoiGian.Models.Entities.Category> ?? new();
    string activeFilter = ViewBag.ActiveFilter as string ?? "today";
    int? activeCat = ViewBag.ActiveCategoryId as int?;
    int completedCount = Model.Count(t => t.Status == TaskItemStatus.Done);
    int totalCount = Model.Count;
    int progressPercent = totalCount > 0 ? (completedCount * 100 / totalCount) : 0;
}

<div class="flex flex-col space-y-6">
    <!-- Greeting & Daily Progress Glance -->
    <section class="flex flex-col space-y-2">
        <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-wider font-semibold text-primary">@DateTime.Now.ToString("dddd, dd 'Tháng' MM", new System.Globalization.CultureInfo("vi-VN"))</span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high text-secondary text-xs font-semibold">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                @completedCount/@totalCount Hoàn thành
            </span>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-on-surface tracking-tight">Chào buổi sáng, Alex! 👋</h1>
            <p class="text-sm text-on-surface-variant mt-1">Hôm nay bạn có @totalCount công việc theo kế hoạch. Hãy bắt đầu thật trọn vẹn!</p>
        </div>
        <!-- Progress Bar -->
        <div class="w-full bg-surface-container-high h-2 rounded-full overflow-hidden flex mt-2">
            <div class="bg-primary-container h-full rounded-full transition-all duration-500" style="width: @(progressPercent)%;"></div>
        </div>
    </section>

    <!-- Quick Search Bar -->
    <section class="relative w-full">
        <form method="get" action="/Task" class="relative flex items-center w-full h-12 bg-surface-container-low rounded-xl px-4 focus-within:bg-surface-container transition-all border border-surface-container-high">
            <span class="material-symbols-outlined text-outline text-[22px] select-none pointer-events-none">search</span>
            <input type="search" name="search" value="@ViewBag.SearchQuery" placeholder="Tìm kiếm công việc, danh mục..." class="w-full h-full bg-transparent pl-3 pr-4 text-on-surface placeholder:text-outline text-sm focus:outline-none" />
            <input type="hidden" name="filter" value="@activeFilter" />
            @if (activeCat.HasValue) { <input type="hidden" name="categoryId" value="@activeCat.Value" /> }
            <button type="submit" class="w-8 h-8 flex items-center justify-center rounded-lg text-outline hover:text-on-surface transition-colors">
                <span class="material-symbols-outlined text-[20px]">tune</span>
            </button>
        </form>
    </section>

    <!-- Horizontal Category Filter Chips -->
    <section class="-mx-4 px-4 overflow-x-auto no-scrollbar flex items-center gap-2 py-1">
        <a href="/Task?filter=all" class="shrink-0 h-9 px-4 rounded-full text-xs font-semibold flex items-center justify-center transition-all @(activeFilter == "all" && !activeCat.HasValue ? "bg-primary-container text-on-primary-container shadow-md" : "bg-surface-container-high text-on-surface-variant hover:text-on-surface")">
            Tất cả
        </a>
        <a href="/Task?filter=today" class="shrink-0 h-9 px-4 rounded-full text-xs font-semibold flex items-center justify-center transition-all @(activeFilter == "today" && !activeCat.HasValue ? "bg-primary-container text-on-primary-container shadow-md" : "bg-surface-container-high text-on-surface-variant hover:text-on-surface")">
            <span class="material-symbols-outlined text-[15px] mr-1">today</span>
            Hôm nay
        </a>
        <a href="/Task?filter=upcoming" class="shrink-0 h-9 px-4 rounded-full text-xs font-semibold flex items-center justify-center transition-all @(activeFilter == "upcoming" && !activeCat.HasValue ? "bg-primary-container text-on-primary-container shadow-md" : "bg-surface-container-high text-on-surface-variant hover:text-on-surface")">
            Sắp tới
        </a>
        @foreach (var cat in categories)
        {
            <a href="/Task?categoryId=@cat.Id" class="shrink-0 h-9 px-4 rounded-full text-xs font-semibold flex items-center justify-center transition-all @(activeCat == cat.Id ? "bg-primary-container text-on-primary-container shadow-md" : "bg-surface-container-high text-on-surface-variant hover:text-on-surface")">
                @cat.Name
            </a>
        }
    </section>

    <!-- Task Header -->
    <div class="flex items-center justify-between pt-2">
        <h2 class="text-lg font-bold text-on-surface flex items-center gap-2">
            Ưu tiên hôm nay
            <span class="w-2 h-2 rounded-full bg-tertiary-container"></span>
        </h2>
    </div>

    <!-- Task Cards Stack -->
    <div class="flex flex-col space-y-3" id="task-list">
        @if (Model.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-12 text-center bg-surface-container-low rounded-2xl border border-dashed border-surface-container-high">
                <span class="material-symbols-outlined text-5xl text-outline mb-2">task_alt</span>
                <p class="text-on-surface font-semibold">Chưa có công việc nào!</p>
                <p class="text-xs text-on-surface-variant mt-1">Bấm nút (+) góc dưới để thêm công việc đầu tiên của bạn.</p>
            </div>
        }

        @foreach (var item in Model)
        {
            bool isDone = item.Status == TaskItemStatus.Done;
            string priorityStripColor = item.Priority switch
            {
                TaskPriority.Urgent => "bg-tertiary-container",
                TaskPriority.High => "bg-primary-container",
                TaskPriority.Medium => "bg-secondary-container",
                _ => "bg-surface-container-highest"
            };

            <div class="task-card group relative flex flex-col p-4 rounded-2xl bg-surface-container-low hover:bg-surface-container shadow-md transition-all duration-200 overflow-hidden border border-surface-container-high/40 @(isDone ? "opacity-60" : "")">
                <!-- Accent priority left strip -->
                <div class="absolute left-0 top-0 bottom-0 w-1.5 @priorityStripColor"></div>

                <div class="flex items-start justify-between gap-3 pl-1.5">
                    <div class="flex items-start gap-3 flex-1 min-w-0">
                        <!-- Quick Complete Checkbox -->
                        <button onclick="toggleTask(@item.Id)" class="shrink-0 mt-0.5 w-7 h-7 rounded-full flex items-center justify-center transition-all @(isDone ? "bg-secondary text-on-secondary" : "bg-surface-container-high text-transparent hover:text-secondary")">
                            <span class="material-symbols-outlined text-[18px]">check</span>
                        </button>
                        <div class="flex flex-col min-w-0 pr-1">
                            <h3 class="task-title font-semibold text-on-surface truncate leading-snug @(isDone ? "line-through text-outline" : "")">
                                @item.Title
                            </h3>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="text-xs text-on-surface-variant truncate mt-0.5">@item.Description</p>
                            }
                        </div>
                    </div>

                    <!-- Quick Play Pomodoro Action -->
                    <a href="/Focus?taskId=@item.Id" title="Bắt đầu Pomodoro" class="shrink-0 w-9 h-9 rounded-full bg-surface-container-high hover:bg-primary-container hover:text-on-primary-container text-primary flex items-center justify-center transition-all shadow-sm">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                    </a>
                </div>

                <!-- Badges & Metas -->
                <div class="flex flex-wrap items-center justify-between gap-2 mt-3 pt-2 pl-1.5 border-t border-surface-container-high/30">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        @if (item.Category != null)
                        {
                            <span class="px-2.5 py-0.5 rounded-md bg-surface-container-high text-primary text-[11px] font-semibold uppercase tracking-wider">
                                @item.Category.Name
                            </span>
                        }
                        @if (item.Deadline.HasValue)
                        {
                            <span class="px-2.5 py-0.5 rounded-md bg-surface-container text-on-surface-variant text-[11px] font-semibold flex items-center gap-1">
                                <span class="material-symbols-outlined text-[13px]">schedule</span>
                                @item.Deadline.Value.ToString("dd/MM HH:mm")
                            </span>
                        }
                    </div>
                    <!-- Pomodoro Tracker -->
                    <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-surface-container-high text-[11px] text-on-surface-variant">
                        <span>🍅</span>
                        <span class="font-bold text-on-surface">@item.CompletedPomodoros/@item.EstimatedPomodoros</span>
                        <span class="text-outline hidden xs:inline">Pomodoro</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Ambient Inspirational Micro-card -->
    <div class="w-full p-4 rounded-2xl bg-surface-container-high/50 flex items-center gap-3 border border-surface-container-high/60 shadow-sm">
        <div class="w-10 h-10 rounded-xl bg-primary-container/20 text-primary flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[22px]">psychology</span>
        </div>
        <div class="flex flex-col min-w-0">
            <span class="text-xs text-primary uppercase font-bold tracking-wide">Mẹo Flow State</span>
            <p class="text-xs text-on-surface-variant truncate">
                Tắt thông báo điện thoại trước khi bấm bắt đầu phiên Pomodoro 25 phút.
            </p>
        </div>
    </div>
</div>

<!-- Floating Action Button (FAB) -->
<div class="fixed right-5 bottom-20 z-40">
    <button onclick="openCreateModal()" class="w-14 h-14 rounded-full bg-gradient-to-tr from-primary-container to-secondary flex items-center justify-center text-on-primary shadow-[0_8px_24px_rgba(128,131,255,0.45)] hover:scale-105 active:scale-95 transition-all duration-200 focus:outline-none">
        <span class="material-symbols-outlined text-[30px] font-bold">add</span>
    </button>
</div>

<!-- CREATE TASK MODAL -->
<div id="createTaskModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-surface-container-low border border-surface-container-high w-full max-w-lg rounded-3xl p-6 shadow-2xl relative flex flex-col space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary">
                <span class="material-symbols-outlined">add_task</span>
                <h3 class="font-bold text-lg text-on-surface">Tạo công việc mới</h3>
            </div>
            <button onclick="closeCreateModal()" class="w-8 h-8 rounded-full bg-surface-container-high text-on-surface-variant hover:text-on-surface flex items-center justify-center">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>

        <form method="post" action="/Task/Create" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-on-surface-variant mb-1">Tên công việc</label>
                <input type="text" name="Title" required placeholder="Nhập tên việc cần làm..." class="w-full bg-surface-container rounded-xl px-4 py-3 text-sm text-on-surface placeholder:text-outline border border-surface-container-high focus:outline-none focus:border-primary-container" />
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-on-surface-variant mb-1">Chi tiết & Ghi chú</label>
                <textarea name="Description" rows="2" placeholder="Thêm ghi chú, link hoặc checklist..." class="w-full bg-surface-container rounded-xl px-4 py-2.5 text-sm text-on-surface placeholder:text-outline border border-surface-container-high focus:outline-none focus:border-primary-container"></textarea>
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-on-surface-variant mb-1">Thời hạn hoàn thành (Deadline)</label>
                <input type="datetime-local" name="Deadline" class="w-full bg-surface-container rounded-xl px-4 py-2.5 text-sm text-on-surface border border-surface-container-high focus:outline-none focus:border-primary-container" />
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-on-surface-variant mb-1">Danh mục</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var cat in categories)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="CategoryId" value="@cat.Id" class="peer sr-only" />
                            <span class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-surface-container text-on-surface-variant peer-checked:bg-primary-container peer-checked:text-on-primary-container peer-checked:shadow-sm flex items-center gap-1 transition-all">
                                <span class="material-symbols-outlined text-[14px]">label</span>
                                @cat.Name
                            </span>
                        </label>
                    }
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-on-surface-variant mb-1">Độ ưu tiên</label>
                <div class="grid grid-cols-4 gap-2 text-center text-xs">
                    <label class="cursor-pointer">
                        <input type="radio" name="Priority" value="1" class="peer sr-only" />
                        <div class="py-2 rounded-xl bg-surface-container text-on-surface-variant peer-checked:bg-secondary-container peer-checked:text-white font-semibold transition-all">Thấp</div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="Priority" value="2" checked class="peer sr-only" />
                        <div class="py-2 rounded-xl bg-surface-container text-on-surface-variant peer-checked:bg-primary-container peer-checked:text-white font-semibold transition-all">T.Bình</div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="Priority" value="3" class="peer sr-only" />
                        <div class="py-2 rounded-xl bg-surface-container text-on-surface-variant peer-checked:bg-amber-600 peer-checked:text-white font-semibold transition-all">Cao</div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="Priority" value="4" class="peer sr-only" />
                        <div class="py-2 rounded-xl bg-surface-container text-on-surface-variant peer-checked:bg-tertiary-container peer-checked:text-white font-semibold transition-all">Khẩn cấp</div>
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-between p-3 bg-surface-container rounded-xl border border-surface-container-high">
                <div class="flex flex-col">
                    <span class="text-sm font-semibold text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[18px] text-primary">timer</span>
                        Ước tính Pomodoro
                    </span>
                    <span class="text-[11px] text-on-surface-variant" id="pomoTimeEstimate">≈ 25 phút tập trung</span>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" onclick="adjustPomo(-1)" class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface font-bold hover:bg-surface-container-highest">-</button>
                    <span id="pomoCountDisplay" class="font-bold text-sm text-on-surface min-w-[30px] text-center">1 phiên</span>
                    <button type="button" onclick="adjustPomo(1)" class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface font-bold hover:bg-surface-container-highest">+</button>
                    <input type="hidden" name="EstimatedPomodoros" id="pomoInput" value="1" />
                </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="button" onclick="closeCreateModal()" class="flex-1 py-3 rounded-2xl bg-surface-container-high text-on-surface-variant font-semibold text-sm hover:text-on-surface transition-all">
                    Hủy
                </button>
                <button type="submit" class="flex-1 py-3 rounded-2xl bg-gradient-to-r from-primary-container to-secondary text-on-primary font-bold text-sm shadow-lg hover:brightness-110 active:scale-98 transition-all flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    Lưu công việc
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateModal() {
            const modal = document.getElementById('createTaskModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCreateModal() {
            const modal = document.getElementById('createTaskModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        let pomoCount = 1;
        function adjustPomo(delta) {
            pomoCount = Math.max(1, Math.min(20, pomoCount + delta));
            document.getElementById('pomoInput').value = pomoCount;
            document.getElementById('pomoCountDisplay').textContent = pomoCount + ' phiên';
            document.getElementById('pomoTimeEstimate').textContent = '≈ ' + (pomoCount * 25) + ' phút tập trung';
        }

        async function toggleTask(taskId) {
            try {
                const response = await fetch('/Task/ToggleStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + taskId
                });
                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
}
